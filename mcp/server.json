{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.tylergarlick/abraxas",
  "description": "Epistemic tooling and persistent context for Abraxas skills: claims, memory, tasks, and flexible JSON/NeDB storage.",
  "repository": {
    "url": "https://github.com/TylerGarlick/abraxas",
    "source": "github",
    "subfolder": "mcp"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registry_type": "npm",
      "identifier": "@tylergarlick/abraxas-mcp",
      "version": "1.0.0",
      "runtime_hint": "bunx",
      "transport": { "type": "stdio" },
      "environment_variables": [
        { "name": "ABRAXAS_ROOT", "description": "Workspace root containing the private .abraxas folder (defaults to the nearest git/.abraxas ancestor of the cwd).", "is_required": false },
        { "name": "ABRAXAS_STORAGE", "description": "Storage backend: \"json\" (default) or \"nedb\".", "is_required": false },
        { "name": "ABRAXAS_DATA_DIR", "description": "Override the data directory (default <root>/.abraxas/data).", "is_required": false },
        { "name": "ABRAXAS_LOG_LEVEL", "description": "debug | info | warn | error (default info).", "is_required": false }
      ]
    }
  ]
}
