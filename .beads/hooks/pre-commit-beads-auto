#!/usr/bin/env sh
# Beads Auto-Commit Hook
# Detects changes in .beads/ directory and auto-commits them before the main commit proceeds
# This ensures bead schema/configuration changes are always committed atomically

set -e

# Only run in git repositories
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    exit 0
fi

# Get list of staged files in .beads/ directory
BEADS_CHANGES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep "^\.beads/" || true)

if [ -z "$BEADS_CHANGES" ]; then
    # No .beads files staged, nothing to do
    exit 0
fi

# Check if this is a beads schema/config change (not just runtime files)
SCHEMA_CHANGES=""
for file in $BEADS_CHANGES; do
    case "$file" in
        # Skip runtime files that shouldn't trigger auto-commit
        .beads/interactions.jsonl|.beads/last-touched|.beads/.local_version|.beads/redirect)
            continue
            ;;
        # Skip daemon/runtime lock files
        .beads/*.lock|.beads/daemon.*|.beads/bd.sock*)
            continue
            ;;
        # Skip export-state and sync state
        .beads/export-state*|.beads/.sync.lock|.beads/sync-state.json)
            continue
            ;;
        # Skip ephemeral SQLite files
        .beads/ephemeral.sqlite3*)
            continue
            ;;
        # All other .beads files are schema/config changes
        *)
            SCHEMA_CHANGES="$SCHEMA_CHANGES $file"
            ;;
    esac
done

# Trim leading space
SCHEMA_CHANGES=$(echo "$SCHEMA_CHANGES" | sed 's/^ //')

if [ -z "$SCHEMA_CHANGES" ]; then
    # Only runtime files changed, no auto-commit needed
    exit 0
fi

echo "beads: detected schema/config changes in .beads/ directory"
echo "beads: auto-committing beads files before main commit..."

# Get the commit message from the environment (set by prepare-commit-msg or git)
COMMIT_MSG="${GIT_COMMIT_MSG:-Auto-commit beads configuration changes}"

# Stage all .beads changes (in case some were missed)
git add .beads/ 2>/dev/null || true

# Create a separate commit for beads changes
# Use --no-verify to prevent recursive hook invocation
git commit --no-verify -m "beads: auto-commit configuration changes

This commit was automatically generated by the beads pre-commit hook.
Schema/configuration changes in .beads/ are committed separately to ensure
clean separation between beads metadata and application code.

Files:
$(git diff --cached --name-only | grep "^\.beads/" | sed 's/^/  - /')" 2>/dev/null || {
    # If commit fails (e.g., nothing to commit), just continue
    echo "beads: no additional changes to commit, continuing..."
    exit 0
}

echo "beads: ✓ beads files committed separately"
echo "beads: proceeding with main commit..."

# Reset the staged state so the main commit can proceed with remaining files
# The beads changes are now committed, so they won't be in the next commit
exit 0
